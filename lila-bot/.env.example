# Скопируйте в .env и заполните. Пустые строки — функция выключена.

# Адрес, где работает этот сервер (https обязателен). Без него бот Telegram работает опросом, MAX и ЮKassa не работают.
PUBLIC_URL=https://lila-api.example.ru
# Адрес игры для мессенджеров
APP_URL=https://iliafreedive-del.github.io/Lila/lila-app/
ALLOWED_ORIGIN=https://iliafreedive-del.github.io
PORT=8080

# Telegram: токен от @BotFather
BOT_TOKEN=
# Ваш числовой id в Telegram (узнать у @userinfobot) — для команды /refund
ADMIN_TG_ID=
# Контакт поддержки для /paysupport, например @username
SUPPORT_CONTACT=

# MAX: токен бота с business.max.ru
MAX_TOKEN=
# Имя бота MAX, если к нему подключено мини-приложение (тогда кнопка открывает его внутри MAX)
MAX_BOT_NAME=

# ЮKassa: shopId и секретный ключ из личного кабинета (Интеграция → Ключи API)
YK_SHOP_ID=
YK_SECRET=
